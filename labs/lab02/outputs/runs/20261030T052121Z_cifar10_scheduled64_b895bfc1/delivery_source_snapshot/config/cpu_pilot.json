{
  "dataset": "CIFAR10",
  "seed": 42,
  "threads": 4,
  "train_limit": 1000,
  "val_limit": 400,
  "test_limit": 1000,
  "models": [
    "resnet18",
    "densenet121"
  ],
  "learning_rates": [
    0.001,
    0.01
  ],
  "batch_sizes": [
    64,
    128
  ],
  "head_epochs": 5,
  "finetune_epochs": 2,
  "finetune_backbone_lr": 1e-05,
  "finetune_head_lr": 0.0001,
  "weight_decay": 0.0001,
  "feature_batch_size": 64,
  "image_size": 64,
  "cache_frozen_prefix": true,
  "profile": "cifar10_cpu_pilot",
  "notes": "Smoke/pilot only; batch grid 64/128. Two fine epochs are a pipeline check, never evidence of convergence."
}
